package com.dam.ejercicio1b;

public class Ejercicio1b {
	
	static final int INICIO = 94;
	static final int CANT_TERMS = 18;
	static final int SALTO = 4;

	public static void main(String[] args) {
		
		int n = INICIO;
		
		for (int i = 0; i < CANT_TERMS; i += SALTO) {
			
			n +=  SALTO;
			System.out.println(n);
			if (i!=0) {
			System.out.println(" - ");
			}
		}

	}

}
