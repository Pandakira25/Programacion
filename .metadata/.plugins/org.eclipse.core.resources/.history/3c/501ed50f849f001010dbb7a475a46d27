package com.dam.ejif;

import java.util.Scanner;

public class Ejercicio_3 {
	
	static final int PH = 16;//Precio horas normales
	static final int PHE = 20; //Precio horas extra
	static final int MAXH = 40;

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Introduce el número de horas completas trabajadas: ");
		int h = Integer.parseInt(sc.next());
		int sn; //Salario normal
		 
		
		if (h <= MAXH) {
			
			sn = h * PH;
			System.out.println("Tu salario es: " + sn);
			
		} else {
			
			int he =  (MAXH * PH) + (h - MAXH) * PHE;// Horas extra
			System.out.println("El sueldo con horas extra es: " + he);
		
		}
		
		
		
		
		
		
		sc.close();

	}

}
