package com.dam.main;

import java.util.Scanner;

import com.dam.pojo.Piramide;

public class CompararPiramidesConUnMetodo {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Ingrese el nombre de la piramide 1, cuanto mide un lado de la base en centímetros y su altura en centímetros");
		String n1 = sc.nextLine();
		double l1 = Double.parseDouble(sc.nextLine());
		double a1 = Double.parseDouble(sc.nextLine());
		
		Piramide piramide1 = new Piramide(n1,l1,a1);
		
		System.out.println("Ingrese el nombre de la piramide 2, cuanto mide un lado de la base en centímetros y su altura en centímetros");
		String n2 = sc.nextLine();
		double l2 = Double.parseDouble(sc.nextLine());
		double a2 = Double.parseDouble(sc.nextLine());
		
		Piramide piramide2 = new Piramide(n2,l2,a2);
		
		sc.close();
		
		System.out.println(piramide1.toString());
		System.out.println(piramide2.toString());
		
		
		double volumen1 = piramide1.volumen();
		double volumen2 = piramide2.volumen();
		

		if (volumen1>volumen2) {
			System.out.println("La piramide " + n1 + " tiene mayor volumen.");
		}else if(volumen1<volumen2) {
			System.out.println("La piramide " + n2 + " tiene mayor volumen.");
		}else {
			System.out.println("Ambas piramides tienen el mismo volumen.");
		}
		
		if (a1>a2) {
			System.out.println("La piramide " + n1 + " tiene mayor altura.");
		}else if (a1<a2) {
			System.out.println("La piramide " + n2 + " tiene mayor altura.");
		}else {
			System.out.println("Ambas piramides tienen la misma altura.");
		}

	}

}
